{
  "name": "dsh-plugin-suki-pet",
  "version": "0.1.0",
  "type": "module",
  "description": "Suki desktop pet rendered as a floating layer inside the DSH web GUI",
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "assets/**",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": []
    },
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shixiaoyu-funny/suki-dsh-plugin.git"
  },
  "homepage": "https://github.com/shixiaoyu-funny/suki-dsh-plugin",
  "bugs": {
    "url": "https://github.com/shixiaoyu-funny/suki-dsh-plugin/issues"
  },
  "license": "MIT",
  "author": "shixiaoyu-funny",
  "publishConfig": {
    "access": "public"
  }
}
